<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hotel.desktop.controller.MainController"
            styleClass="root-pane"
            prefWidth="1280.0" prefHeight="800.0">

    <!-- Top Navigation / Brand Header -->
    <top>
        <VBox styleClass="header-bar">
            <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="header-content">
                <padding>
                    <Insets top="16.0" right="32.0" bottom="16.0" left="32.0"/>
                </padding>
                <Label text="🏨" styleClass="brand-icon"/>
                <VBox alignment="CENTER_LEFT" spacing="2.0">
                    <Label text="HOTEL BOOKING SYSTEM" styleClass="brand-title"/>
                    <Label text="Desktop Edition • Spring Boot REST Client" styleClass="brand-subtitle"/>
                </VBox>
            </HBox>
            <Separator styleClass="header-separator"/>
        </VBox>
    </top>

    <!-- Center Hero Card Container -->
    <center>
        <VBox alignment="CENTER" spacing="32.0" styleClass="content-area">
            <padding>
                <Insets top="40.0" right="40.0" bottom="40.0" left="40.0"/>
            </padding>

            <VBox alignment="CENTER" spacing="24.0" styleClass="welcome-card" maxWidth="720.0">
                <padding>
                    <Insets top="48.0" right="48.0" bottom="48.0" left="48.0"/>
                </padding>

                <!-- Icon Badge -->
                <HBox alignment="CENTER">
                    <Label text="✨" styleClass="hero-badge-icon"/>
                </HBox>

                <!-- Titles -->
                <VBox alignment="CENTER" spacing="8.0">
                    <Label text="Hotel Booking Management System" styleClass="welcome-heading"/>
                    <Label text="Official desktop booking application consuming Spring Boot REST APIs with JWT security"
                           styleClass="welcome-subtitle" wrapText="true" textAlignment="CENTER"/>
                </VBox>

                <!-- Status Pill Indicator -->
                <HBox alignment="CENTER" spacing="10.0" styleClass="status-pill">
                    <padding>
                        <Insets top="8.0" right="18.0" bottom="8.0" left="18.0"/>
                    </padding>
                    <Label text="●" styleClass="status-dot"/>
                    <Label fx:id="statusLabel" text="Status: JavaFX Application Ready" styleClass="status-text"/>
                </HBox>

                <Separator styleClass="card-separator"/>

                <!-- Tech Badges -->
                <HBox alignment="CENTER" spacing="12.0" styleClass="badges-row">
                    <Label fx:id="javafxVersionLabel" text="JavaFX: 21.0.2" styleClass="tech-badge"/>
                    <Label fx:id="javaVersionLabel" text="Java: 21 Target" styleClass="tech-badge"/>
                    <Label text="Backend: Port 5001" styleClass="tech-badge"/>
                    <Label text="Phase 9.2: Initial Setup" styleClass="tech-badge tech-badge-primary"/>
                </HBox>
            </VBox>
        </VBox>
    </center>

    <!-- Bottom Status Bar -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="footer-bar">
            <padding>
                <Insets top="10.0" right="24.0" bottom="10.0" left="24.0"/>
            </padding>
            <Label text="Architecture: JavaFX Desktop Frontend • Spring Boot 3.4.2 REST • MySQL 8" styleClass="footer-text"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Label text="Phase 9.2 Verification Build" styleClass="footer-text-muted"/>
        </HBox>
    </bottom>
</BorderPane>

