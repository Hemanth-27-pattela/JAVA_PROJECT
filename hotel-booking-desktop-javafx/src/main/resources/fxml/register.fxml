<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hotel.desktop.controller.RegisterController"
            styleClass="root-pane"
            prefWidth="1280.0" prefHeight="800.0">

    <!-- Top Navigation Header -->
    <top>
        <VBox styleClass="header-bar">
            <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="header-content">
                <padding>
                    <Insets top="16.0" right="32.0" bottom="16.0" left="32.0"/>
                </padding>
                <Label text="🏨" styleClass="brand-icon"/>
                <VBox alignment="CENTER_LEFT" spacing="2.0">
                    <Label text="HOTEL BOOKING SYSTEM" styleClass="brand-title"/>
                    <Label text="Desktop Edition • Spring Boot REST Client" styleClass="brand-subtitle"/>
                </VBox>
                <HBox HBox.hgrow="ALWAYS"/>
                <Button fx:id="loginLinkButton" text="Sign In" onAction="#handleNavigateLogin"
                        styleClass="header-nav-button"/>
            </HBox>
            <Separator styleClass="header-separator"/>
        </VBox>
    </top>

    <!-- Center Registration Form Card -->
    <center>
        <VBox alignment="CENTER" spacing="20.0" styleClass="content-area">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>

            <VBox alignment="TOP_CENTER" spacing="16.0" styleClass="auth-card" maxWidth="520.0">
                <padding>
                    <Insets top="32.0" right="36.0" bottom="32.0" left="36.0"/>
                </padding>

                <!-- Header inside Card -->
                <VBox alignment="CENTER" spacing="6.0">
                    <Label text="Create an Account" styleClass="auth-heading"/>
                    <Label text="Join to book rooms, manage reservations, and track stays"
                           styleClass="auth-subtitle" wrapText="true" textAlignment="CENTER"/>
                </VBox>

                <!-- Error Alert Box -->
                <VBox fx:id="errorContainer" managed="false" visible="false" styleClass="alert-box-error">
                    <padding>
                        <Insets top="10.0" right="14.0" bottom="10.0" left="14.0"/>
                    </padding>
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label text="⚠️" styleClass="alert-icon"/>
                        <Label fx:id="errorLabel" text="Error message" styleClass="alert-text-error" wrapText="true"/>
                    </HBox>
                </VBox>

                <!-- Success Alert Box -->
                <VBox fx:id="successContainer" managed="false" visible="false" styleClass="alert-box-success">
                    <padding>
                        <Insets top="10.0" right="14.0" bottom="10.0" left="14.0"/>
                    </padding>
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label text="✓" styleClass="alert-icon"/>
                        <Label fx:id="successLabel" text="Success message" styleClass="alert-text-success" wrapText="true"/>
                    </HBox>
                </VBox>

                <!-- Form Fields -->
                <VBox spacing="12.0" alignment="TOP_LEFT">
                    <!-- Names Row -->
                    <HBox spacing="12.0">
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <Label text="First Name" styleClass="field-label"/>
                            <TextField fx:id="firstNameField" promptText="e.g. Jane" styleClass="input-field"/>
                        </VBox>
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <Label text="Last Name" styleClass="field-label"/>
                            <TextField fx:id="lastNameField" promptText="e.g. Doe" styleClass="input-field"/>
                        </VBox>
                    </HBox>

                    <!-- Email -->
                    <VBox spacing="6.0">
                        <Label text="Email Address" styleClass="field-label"/>
                        <TextField fx:id="emailField" promptText="e.g. jane.doe@example.com" styleClass="input-field"/>
                    </VBox>

                    <!-- Passwords Row -->
                    <HBox spacing="12.0">
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <Label text="Password (min 6 chars)" styleClass="field-label"/>
                            <PasswordField fx:id="passwordField" promptText="••••••••" styleClass="input-field"/>
                        </VBox>
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <Label text="Confirm Password" styleClass="field-label"/>
                            <PasswordField fx:id="confirmPasswordField" promptText="••••••••"
                                           onAction="#handleRegister" styleClass="input-field"/>
                        </VBox>
                    </HBox>

                    <!-- Role Notice -->
                    <HBox alignment="CENTER_LEFT" spacing="6.0" styleClass="role-notice-box">
                        <padding>
                            <Insets top="6.0" right="10.0" bottom="6.0" left="10.0"/>
                        </padding>
                        <Label text="ℹ" styleClass="role-notice-icon"/>
                        <Label text="New accounts register with standard Guest permissions." styleClass="role-notice-text"/>
                    </HBox>
                </VBox>

                <!-- Submit Button & Spinner -->
                <VBox spacing="10.0" alignment="CENTER">
                    <StackPane>
                        <Button fx:id="registerButton" text="Create Guest Account" onAction="#handleRegister"
                                defaultButton="true" styleClass="btn-primary" maxWidth="Infinity"/>
                        <ProgressIndicator fx:id="progressIndicator" maxHeight="24.0" maxWidth="24.0"
                                           visible="false" styleClass="spinner"/>
                    </StackPane>
                </VBox>

                <Separator styleClass="card-separator"/>

                <!-- Sign In Link -->
                <HBox alignment="CENTER" spacing="6.0">
                    <Label text="Already registered?" styleClass="footer-link-label"/>
                    <Button text="Sign in to your account" onAction="#handleNavigateLogin"
                            styleClass="link-button"/>
                </HBox>
            </VBox>
        </VBox>
    </center>

    <!-- Bottom Status Bar -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="footer-bar">
            <padding>
                <Insets top="10.0" right="24.0" bottom="10.0" left="24.0"/>
            </padding>
            <Label text="Spring Boot REST API: http://localhost:5001" styleClass="footer-text"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Label text="Phase 9.3 • JavaFX Desktop Client" styleClass="footer-text-muted"/>
        </HBox>
    </bottom>
</BorderPane>

