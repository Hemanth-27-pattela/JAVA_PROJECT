<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hotel.desktop.controller.MyBookingsController"
      spacing="16.0"
      styleClass="my-bookings-container">

    <padding>
        <Insets top="20.0" right="24.0" bottom="24.0" left="24.0"/>
    </padding>

    <!-- Top Header Card -->
    <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="details-header-card">
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <Label text="My Bookings" styleClass="details-title"/>
            <Label text="Manage your reservations, view stay details, and process eligible cancellations." styleClass="details-location"/>
        </VBox>
        <Button fx:id="refreshButton" text="🔄 Refresh" styleClass="btn-outline"/>
    </HBox>

    <!-- Filter Tabs Row -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button fx:id="filterAllButton" text="All Bookings (0)" styleClass="filter-tab-button, filter-tab-button-active"/>
        <Button fx:id="filterUpcomingButton" text="Upcoming / Active (0)" styleClass="filter-tab-button"/>
        <Button fx:id="filterCompletedButton" text="Completed (0)" styleClass="filter-tab-button"/>
        <Button fx:id="filterCancelledButton" text="Cancelled (0)" styleClass="filter-tab-button"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="💳 Demo / Simulated Mode" styleClass="badge-demo-mode"/>
    </HBox>

    <!-- Main Content Container with StackPane for States -->
    <StackPane VBox.vgrow="ALWAYS">
        <!-- Scrollable Bookings List -->
        <ScrollPane fx:id="scrollPane" fitToWidth="true" styleClass="hotel-scroll-pane">
            <VBox fx:id="bookingsListBox" spacing="14.0">
                <padding>
                    <Insets top="4.0" right="10.0" bottom="20.0" left="4.0"/>
                </padding>
            </VBox>
        </ScrollPane>

        <!-- Loading State Overlay -->
        <VBox fx:id="loadingBox" alignment="CENTER" spacing="14.0" styleClass="empty-state-box" visible="false" managed="false">
            <ProgressIndicator prefWidth="42.0" prefHeight="42.0"/>
            <Label text="Loading your reservations..." styleClass="loading-state-text"/>
        </VBox>

        <!-- Empty State Overlay -->
        <VBox fx:id="emptyBox" alignment="CENTER" spacing="12.0" styleClass="empty-state-box" visible="false" managed="false">
            <Label text="📅" styleClass="empty-state-icon"/>
            <Label fx:id="emptyTitleLabel" text="No Bookings Found" styleClass="empty-state-title"/>
            <Label fx:id="emptySubtitleLabel" text="You have no reservations under this category. Plan your next stay now!" styleClass="empty-state-subtitle" textAlignment="CENTER"/>
            <Button fx:id="browseHotelsButton" text="Browse Available Hotels" styleClass="btn-primary">
                <VBox.margin>
                    <Insets top="8.0"/>
                </VBox.margin>
            </Button>
        </VBox>

        <!-- Error State Overlay -->
        <VBox fx:id="errorBox" alignment="CENTER" spacing="12.0" styleClass="error-state-box" visible="false" managed="false">
            <Label text="⚠️" styleClass="error-state-icon"/>
            <Label text="Failed to Load Bookings" styleClass="error-state-title"/>
            <Label fx:id="errorMessageLabel" text="An unexpected error occurred while communicating with the server." styleClass="error-state-subtitle" textAlignment="CENTER" wrapText="true"/>
            <Button fx:id="retryButton" text="Try Again" styleClass="btn-primary">
                <VBox.margin>
                    <Insets top="8.0"/>
                </VBox.margin>
            </Button>
        </VBox>
    </StackPane>

</VBox>
