<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hotel.desktop.controller.LoginController"
            styleClass="root-pane"
            prefWidth="1280.0" prefHeight="800.0">

    <!-- Top Navigation Header -->
    <top>
        <VBox styleClass="header-bar">
            <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="header-content">
                <padding>
                    <Insets top="16.0" right="32.0" bottom="16.0" left="32.0"/>
                </padding>
                <Label text="🏨" styleClass="brand-icon"/>
                <VBox alignment="CENTER_LEFT" spacing="2.0">
                    <Label text="HOTEL BOOKING SYSTEM" styleClass="brand-title"/>
                    <Label text="Desktop Edition • Spring Boot REST Client" styleClass="brand-subtitle"/>
                </VBox>
                <HBox HBox.hgrow="ALWAYS"/>
                <Button fx:id="registerLinkButton" text="Create Account" onAction="#handleNavigateRegister"
                        styleClass="header-nav-button"/>
            </HBox>
            <Separator styleClass="header-separator"/>
        </VBox>
    </top>

    <!-- Center Login Form Card -->
    <center>
        <VBox alignment="CENTER" spacing="20.0" styleClass="content-area">
            <padding>
                <Insets top="30.0" right="20.0" bottom="30.0" left="20.0"/>
            </padding>

            <VBox alignment="TOP_CENTER" spacing="18.0" styleClass="auth-card" maxWidth="480.0">
                <padding>
                    <Insets top="36.0" right="36.0" bottom="36.0" left="36.0"/>
                </padding>

                <!-- Header inside Card -->
                <VBox alignment="CENTER" spacing="6.0">
                    <Label text="Sign In" styleClass="auth-heading"/>
                    <Label text="Enter your hotel credentials to access your account"
                           styleClass="auth-subtitle" wrapText="true" textAlignment="CENTER"/>
                </VBox>

                <!-- Error Alert Box -->
                <VBox fx:id="errorContainer" managed="false" visible="false" styleClass="alert-box-error">
                    <padding>
                        <Insets top="10.0" right="14.0" bottom="10.0" left="14.0"/>
                    </padding>
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label text="⚠️" styleClass="alert-icon"/>
                        <Label fx:id="errorLabel" text="Error message" styleClass="alert-text-error" wrapText="true"/>
                    </HBox>
                </VBox>

                <!-- Success Alert Box -->
                <VBox fx:id="successContainer" managed="false" visible="false" styleClass="alert-box-success">
                    <padding>
                        <Insets top="10.0" right="14.0" bottom="10.0" left="14.0"/>
                    </padding>
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label text="✓" styleClass="alert-icon"/>
                        <Label fx:id="successLabel" text="Success message" styleClass="alert-text-success" wrapText="true"/>
                    </HBox>
                </VBox>

                <!-- Form Fields -->
                <VBox spacing="14.0" alignment="TOP_LEFT">
                    <!-- Email -->
                    <VBox spacing="6.0">
                        <Label text="Email Address" styleClass="field-label"/>
                        <TextField fx:id="emailField" promptText="e.g. guest@hotel.com"
                                   onAction="#handleLogin" styleClass="input-field"/>
                    </VBox>

                    <!-- Password with Toggle -->
                    <VBox spacing="6.0">
                        <Label text="Password" styleClass="field-label"/>
                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                            <StackPane HBox.hgrow="ALWAYS">
                                <PasswordField fx:id="passwordField" promptText="Enter your password"
                                               onAction="#handleLogin" styleClass="input-field"/>
                                <TextField fx:id="passwordTextField" promptText="Enter your password"
                                           onAction="#handleLogin" styleClass="input-field" managed="false" visible="false"/>
                            </StackPane>
                            <Button fx:id="togglePasswordButton" text="Show" onAction="#handleTogglePassword"
                                    styleClass="toggle-btn" minWidth="65.0"/>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- Submit Button & Spinner -->
                <VBox spacing="10.0" alignment="CENTER">
                    <StackPane>
                        <Button fx:id="loginButton" text="Sign In" onAction="#handleLogin"
                                defaultButton="true" styleClass="btn-primary" maxWidth="Infinity"/>
                        <ProgressIndicator fx:id="progressIndicator" maxHeight="24.0" maxWidth="24.0"
                                           visible="false" styleClass="spinner"/>
                    </StackPane>
                </VBox>

                <!-- Quick Demo Fill Section -->
                <VBox spacing="8.0" alignment="CENTER" styleClass="demo-box">
                    <padding>
                        <Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/>
                    </padding>
                    <Label text="Quick Demo Credentials (password: 12345678)" styleClass="demo-label"/>
                    <HBox spacing="8.0" alignment="CENTER">
                        <Button text="Guest" onAction="#handleFillGuest" styleClass="btn-demo-pill"/>
                        <Button text="Hotel Owner" onAction="#handleFillOwner" styleClass="btn-demo-pill"/>
                        <Button text="Admin" onAction="#handleFillAdmin" styleClass="btn-demo-pill"/>
                    </HBox>
                </VBox>

                <Separator styleClass="card-separator"/>

                <!-- Register Footer Link -->
                <HBox alignment="CENTER" spacing="6.0">
                    <Label text="Don't have an account?" styleClass="footer-link-label"/>
                    <Button text="Register as a Guest" onAction="#handleNavigateRegister"
                            styleClass="link-button"/>
                </HBox>
            </VBox>
        </VBox>
    </center>

    <!-- Bottom Status Bar -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="footer-bar">
            <padding>
                <Insets top="10.0" right="24.0" bottom="10.0" left="24.0"/>
            </padding>
            <Label text="Spring Boot REST API: http://localhost:5001" styleClass="footer-text"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Label text="Phase 9.3 • JavaFX Desktop Client" styleClass="footer-text-muted"/>
        </HBox>
    </bottom>
</BorderPane>

