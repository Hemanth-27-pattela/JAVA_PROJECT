<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hotel.desktop.controller.HomeController"
            styleClass="root-pane"
            prefWidth="1280.0" prefHeight="800.0">

    <!-- Top Navigation Header -->
    <top>
        <VBox styleClass="header-bar">
            <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="header-content">
                <padding>
                    <Insets top="14.0" right="32.0" bottom="14.0" left="32.0"/>
                </padding>
                <Label text="🏨" styleClass="brand-icon"/>
                <VBox alignment="CENTER_LEFT" spacing="2.0">
                    <Label text="HOTEL BOOKING SYSTEM" styleClass="brand-title"/>
                    <Label text="Desktop Edition • Spring Boot REST Client" styleClass="brand-subtitle"/>
                </VBox>
                <HBox HBox.hgrow="ALWAYS"/>

                <!-- User profile badge & Logout -->
                <HBox alignment="CENTER" spacing="12.0">
                    <VBox alignment="CENTER_RIGHT" spacing="2.0">
                        <Label fx:id="userEmailLabel" text="user@example.com" styleClass="header-user-email"/>
                        <Label fx:id="roleBadgeLabel" text="GUEST" styleClass="role-badge role-badge-guest"/>
                    </VBox>
                    <Button fx:id="logoutButton" text="Sign Out" onAction="#handleLogout"
                            styleClass="btn-logout"/>
                </HBox>
            </HBox>
            <Separator styleClass="header-separator"/>
        </VBox>
    </top>

    <!-- Center Content -->
    <center>
        <VBox alignment="TOP_CENTER" spacing="24.0" styleClass="content-area">
            <padding>
                <Insets top="32.0" right="48.0" bottom="32.0" left="48.0"/>
            </padding>

            <!-- Welcome Header Card -->
            <VBox spacing="10.0" styleClass="welcome-card" maxWidth="960.0">
                <padding>
                    <Insets top="28.0" right="32.0" bottom="28.0" left="32.0"/>
                </padding>
                <HBox alignment="CENTER_LEFT" spacing="14.0">
                    <Label text="👋" styleClass="hero-badge-icon"/>
                    <VBox spacing="4.0">
                        <Label fx:id="welcomeHeading" text="Welcome back!" styleClass="welcome-heading"/>
                        <Label text="You have successfully authenticated via Spring Boot REST API (JWT session active)."
                               styleClass="welcome-subtitle"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Role-Specific Action Card -->
            <VBox fx:id="roleFeatureBox" spacing="16.0" styleClass="welcome-card" maxWidth="960.0">
                <padding>
                    <Insets top="28.0" right="32.0" bottom="28.0" left="32.0"/>
                </padding>
                <Label fx:id="roleTitleLabel" text="Role Dashboard" styleClass="card-section-title"/>
                <Label fx:id="roleDescriptionLabel" text="Role description" styleClass="card-description" wrapText="true"/>

                <Separator styleClass="card-separator"/>

                <HBox spacing="12.0" alignment="CENTER_LEFT">
                    <Label text="Upcoming Modules:" styleClass="field-label"/>
                    <Label text="Hotel Search &amp; Filtering" styleClass="tech-badge"/>
                    <Label text="Room Reservation" styleClass="tech-badge"/>
                    <Label text="Property Dashboard" styleClass="tech-badge"/>
                    <Label text="Admin Approvals" styleClass="tech-badge"/>
                </HBox>
            </VBox>

            <!-- Active Session Details Card -->
            <VBox spacing="16.0" styleClass="welcome-card" maxWidth="960.0">
                <padding>
                    <Insets top="24.0" right="32.0" bottom="24.0" left="32.0"/>
                </padding>
                <Label text="Active Session Telemetry" styleClass="card-section-title"/>

                <GridPane hgap="24.0" vgap="12.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="140.0" prefWidth="180.0"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Session User ID:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="field-label"/>
                    <Label fx:id="sessionUserIdLabel" text="uuid" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="session-value"/>

                    <Label text="Email Address:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="field-label"/>
                    <Label fx:id="sessionEmailLabel" text="email" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="session-value"/>

                    <Label text="Active Role:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="field-label"/>
                    <Label fx:id="sessionRoleLabel" text="ROLE" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="session-value"/>

                    <Label text="Authorization Token:" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="field-label"/>
                    <Label fx:id="tokenStatusLabel" text="Active" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="session-value-success"/>
                </GridPane>
            </VBox>
        </VBox>
    </center>

    <!-- Bottom Status Bar -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="footer-bar">
            <padding>
                <Insets top="10.0" right="24.0" bottom="10.0" left="24.0"/>
            </padding>
            <Label text="Status: Connected to Spring Boot on port 5001" styleClass="footer-text"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Label text="Phase 9.3 • Hotel Booking Desktop Client" styleClass="footer-text-muted"/>
        </HBox>
    </bottom>
</BorderPane>

