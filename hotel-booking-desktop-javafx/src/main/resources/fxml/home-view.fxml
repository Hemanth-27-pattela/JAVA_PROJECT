<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.hotel.desktop.controller.HomeController"
      spacing="16.0"
      styleClass="dashboard-root">

    <padding>
        <Insets top="20.0" right="24.0" bottom="24.0" left="24.0"/>
    </padding>

    <!-- Top Hero Welcome Card -->
    <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="rec-hero-card">
        <padding>
            <Insets top="20.0" right="24.0" bottom="20.0" left="24.0"/>
        </padding>

        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="✨" styleClass="rec-hero-icon"/>
                <Label fx:id="welcomeHeading" text="Welcome to Your Travel Portal" styleClass="rec-hero-title"/>
            </HBox>
            <Label fx:id="welcomeSubtitle"
                   text="Intelligent hotel recommendations curated from your stay history, booking preferences, and verified ratings."
                   styleClass="rec-hero-subtitle" wrapText="true"/>
        </VBox>

        <!-- Quick Action Buttons -->
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <Button fx:id="browseHotelsButton" text="🔍 Browse Catalog" onAction="#handleBrowseHotels" styleClass="btn-outline"/>
            <Button fx:id="myBookingsButton" text="📅 My Bookings" onAction="#handleMyBookings" styleClass="btn-outline"/>
            <Button fx:id="refreshAllButton" text="🔄 Refresh All" onAction="#handleRefreshAll" styleClass="btn-primary"/>
        </HBox>
    </HBox>

    <!-- Scrollable Recommendations Content Area -->
    <ScrollPane fx:id="scrollPane" fitToWidth="true" styleClass="hotel-scroll-pane" VBox.vgrow="ALWAYS">
        <VBox spacing="28.0" styleClass="rec-dashboard-content">
            <padding>
                <Insets top="4.0" right="10.0" bottom="24.0" left="4.0"/>
            </padding>

            <!-- ========================================================= -->
            <!-- SECTION 1: PERSONALIZED RECOMMENDATIONS                   -->
            <!-- ========================================================= -->
            <VBox spacing="12.0" styleClass="rec-section-container">
                <!-- Section Header -->
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Label text="Recommended For You" styleClass="rec-section-title"/>
                            <Label text="AI Curated" styleClass="rec-pill-badge"/>
                        </HBox>
                        <Label text="Personalized picks matching your booking tastes, preferred destinations, and luxury amenities."
                               styleClass="rec-section-subtitle"/>
                    </VBox>
                    <Button fx:id="refreshPersonalizedButton" text="🔄 Refresh" onAction="#loadPersonalizedRecommendations"
                            styleClass="rec-btn-mini"/>
                </HBox>

                <!-- Section Body (StackPane for States) -->
                <StackPane minHeight="180.0">
                    <!-- Cards Container -->
                    <FlowPane fx:id="personalizedContainer" hgap="16.0" vgap="16.0" styleClass="rec-flow-container"/>

                    <!-- Loading State -->
                    <VBox fx:id="personalizedLoadingBox" alignment="CENTER" spacing="10.0" styleClass="rec-state-box" visible="false" managed="false">
                        <ProgressIndicator styleClass="rec-spinner" prefWidth="40.0" prefHeight="40.0"/>
                        <Label text="Curating your personalized hotel recommendations..." styleClass="rec-state-text"/>
                    </VBox>

                    <!-- Error State -->
                    <VBox fx:id="personalizedErrorBox" alignment="CENTER" spacing="10.0" styleClass="rec-error-box" visible="false" managed="false">
                        <Label text="⚠️ Unable to load personalized recommendations" styleClass="rec-error-title"/>
                        <Label fx:id="personalizedErrorMessage" text="Network connection error." styleClass="rec-error-subtitle"/>
                        <Button text="Retry Personalized" onAction="#loadPersonalizedRecommendations" styleClass="btn-outline"/>
                    </VBox>

                    <!-- Empty State -->
                    <VBox fx:id="personalizedEmptyBox" alignment="CENTER" spacing="8.0" styleClass="rec-state-box" visible="false" managed="false">
                        <Label text="🏨" styleClass="rec-empty-icon"/>
                        <Label text="No personalized recommendations available yet." styleClass="rec-empty-title"/>
                        <Label text="Book reservations or browse destinations to establish your stay profile!" styleClass="rec-empty-subtitle"/>
                    </VBox>
                </StackPane>
            </VBox>

            <Separator styleClass="rec-divider"/>

            <!-- ========================================================= -->
            <!-- SECTION 2: POPULAR / TRENDING CHOICES                     -->
            <!-- ========================================================= -->
            <VBox spacing="12.0" styleClass="rec-section-container">
                <!-- Section Header -->
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Label text="Trending &amp; Popular Choices" styleClass="rec-section-title"/>
                            <Label text="High Demand" styleClass="rec-pill-badge-popular"/>
                        </HBox>
                        <Label text="Top-booked hotels frequently selected by fellow travelers across prime locations."
                               styleClass="rec-section-subtitle"/>
                    </VBox>
                    <Button fx:id="refreshPopularButton" text="🔄 Refresh" onAction="#loadPopularRecommendations"
                            styleClass="rec-btn-mini"/>
                </HBox>

                <!-- Section Body -->
                <StackPane minHeight="180.0">
                    <FlowPane fx:id="popularContainer" hgap="16.0" vgap="16.0" styleClass="rec-flow-container"/>

                    <VBox fx:id="popularLoadingBox" alignment="CENTER" spacing="10.0" styleClass="rec-state-box" visible="false" managed="false">
                        <ProgressIndicator styleClass="rec-spinner" prefWidth="40.0" prefHeight="40.0"/>
                        <Label text="Discovering trending popular hotels..." styleClass="rec-state-text"/>
                    </VBox>

                    <VBox fx:id="popularErrorBox" alignment="CENTER" spacing="10.0" styleClass="rec-error-box" visible="false" managed="false">
                        <Label text="⚠️ Unable to load popular hotels" styleClass="rec-error-title"/>
                        <Label fx:id="popularErrorMessage" text="Network connection error." styleClass="rec-error-subtitle"/>
                        <Button text="Retry Popular" onAction="#loadPopularRecommendations" styleClass="btn-outline"/>
                    </VBox>

                    <VBox fx:id="popularEmptyBox" alignment="CENTER" spacing="8.0" styleClass="rec-state-box" visible="false" managed="false">
                        <Label text="📈" styleClass="rec-empty-icon"/>
                        <Label text="No trending hotels found at this time." styleClass="rec-empty-title"/>
                    </VBox>
                </StackPane>
            </VBox>

            <Separator styleClass="rec-divider"/>

            <!-- ========================================================= -->
            <!-- SECTION 3: TOP-RATED STAYS                                -->
            <!-- ========================================================= -->
            <VBox spacing="12.0" styleClass="rec-section-container">
                <!-- Section Header -->
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Label text="Highest Guest Ratings" styleClass="rec-section-title"/>
                            <Label text="Guest Favorites" styleClass="rec-pill-badge-top-rated"/>
                        </HBox>
                        <Label text="Consistently celebrated stays backed by Bayesian-weighted authentic guest reviews."
                               styleClass="rec-section-subtitle"/>
                    </VBox>
                    <Button fx:id="refreshTopRatedButton" text="🔄 Refresh" onAction="#loadTopRatedRecommendations"
                            styleClass="rec-btn-mini"/>
                </HBox>

                <!-- Section Body -->
                <StackPane minHeight="180.0">
                    <FlowPane fx:id="topRatedContainer" hgap="16.0" vgap="16.0" styleClass="rec-flow-container"/>

                    <VBox fx:id="topRatedLoadingBox" alignment="CENTER" spacing="10.0" styleClass="rec-state-box" visible="false" managed="false">
                        <ProgressIndicator styleClass="rec-spinner" prefWidth="40.0" prefHeight="40.0"/>
                        <Label text="Retrieving highest rated properties..." styleClass="rec-state-text"/>
                    </VBox>

                    <VBox fx:id="topRatedErrorBox" alignment="CENTER" spacing="10.0" styleClass="rec-error-box" visible="false" managed="false">
                        <Label text="⚠️ Unable to load top-rated stays" styleClass="rec-error-title"/>
                        <Label fx:id="topRatedErrorMessage" text="Network connection error." styleClass="rec-error-subtitle"/>
                        <Button text="Retry Top-Rated" onAction="#loadTopRatedRecommendations" styleClass="btn-outline"/>
                    </VBox>

                    <VBox fx:id="topRatedEmptyBox" alignment="CENTER" spacing="8.0" styleClass="rec-state-box" visible="false" managed="false">
                        <Label text="⭐" styleClass="rec-empty-icon"/>
                        <Label text="No rated hotels found at this time." styleClass="rec-empty-title"/>
                    </VBox>
                </StackPane>
            </VBox>

        </VBox>
    </ScrollPane>

</VBox>
